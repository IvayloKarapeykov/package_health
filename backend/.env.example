# Server-side keys are optional: callers can send their own as X-GitHub-Token / X-OpenRouter-Key headers,
# and these are only the fallback for requests without them. Leave them empty on a public deployment.

# OpenRouter (https://openrouter.ai/keys). Without a key the advisor falls back to rule-based verdicts.
OPENROUTER_API_KEY=
LLM_MODEL=z-ai/glm-5.3-flash
# function_calling | json_schema | json_mode — how the model is asked for structured output
LLM_STRUCTURED_OUTPUT_METHOD=function_calling

# Verdicts (recommended / caution / avoid) come from Jev, TypeSafe's decision model, via
# OpenRouter's Decisions API (same key). The LLM above writes the summary, reasons and alternatives.
USE_JEV_VERDICTS=true
JEV_MODEL=typesafe/jev-1.13

# Optional: raises the GitHub limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=

# Host names the MCP endpoint at /mcp accepts, as a JSON list. Add your domain when deploying,
# e.g. ["vet.example.com", "localhost:*"]
# MCP_ALLOWED_HOSTS=["localhost:*", "127.0.0.1:*", "[::1]:*"]

MAX_PACKAGES=40
MAX_CONCURRENCY=8

# Logging: text (readable) locally, json (one object per line) for log aggregators
LOG_LEVEL=INFO
LOG_FORMAT=text

# Optional LangSmith tracing (https://smith.langchain.com): every run with its nodes, subgraphs,
# LLM and Jev calls. LANGSMITH_HIDE_INPUTS=true keeps pasted dependency files out of LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=package-health-advisor
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=false
